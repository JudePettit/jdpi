        "summary": "One dataset: every field with type and meaning, licence, sources, files, shards and two sample rows.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "congress-members",
                "congress-trades",
                "digital-briefing-sources",
                "digital-briefing-stories",
                "econ-briefing-sources",
                "econ-briefing-stories",
                "encyclopaedia-entities",
                "headline-outlets",
                "intelligence-briefing-sources",
                "intelligence-briefing-stories",
                "investor-holdings",
                "investor-sales",
                "investors",
                "kardashev-polities",
                "kardashev-shares",
                "kardashev-world",
                "kino-documentaries",
                "national-countries",
                "national-indicator-latest",
                "national-indicators",
                "national-key-series",
                "political-calendar",
                "prp-submodules",
                "realtime-conflict-cells",
                "realtime-war-months",
                "realtime-wars",
                "retrospective-wars",
                "science-briefing-sources",
                "science-briefing-stories",
                "science-progress-events",
                "science-progress-institutions",
                "science-progress-people",
                "upcoming-political-events",
                "volatility-daily",
                "volatility-global",
                "volatility-latest",
                "war-focus-battles",
                "war-focus-monthly-deaths",
                "war-focus-wars"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dataset"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/datasets/{id}/rows": {
      "get": {
        "operationId": "queryDataset",
        "tags": [
          "Datasets"
        ],
        "summary": "Filter, sort and page a dataset's rows.",
        "description": "Filters: f.<field>=<value> for equality, or f.<field>.<op>=<value> with op ne, gt, gte, lt, lte, contains, starts_with, in (comma-separated values) or exists (true/false). String comparisons ignore case and accents; contains also tests list fields. Alternatively pass where as JSON: a list of {field, op, value} or an object such as {\"country\":\"France\",\"date\":{\"gte\":\"2024-01-01\"}}. Large datasets are split into shards and read newest first within a time budget: if complete is false, narrow the query or pass next_cursor as cursor.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "congress-members",
                "congress-trades",
                "digital-briefing-sources",
                "digital-briefing-stories",
                "econ-briefing-sources",
                "econ-briefing-stories",
                "encyclopaedia-entities",
                "headline-outlets",
                "intelligence-briefing-sources",
                "intelligence-briefing-stories",
                "investor-holdings",
                "investor-sales",
                "investors",
                "kardashev-polities",
                "kardashev-shares",
                "kardashev-world",
                "kino-documentaries",
                "national-countries",
                "national-indicator-latest",
                "national-indicators",
                "national-key-series",
                "political-calendar",
                "prp-submodules",
                "realtime-conflict-cells",
                "realtime-war-months",
                "realtime-wars",
                "retrospective-wars",
                "science-briefing-sources",
                "science-briefing-stories",
                "science-progress-events",
                "science-progress-institutions",
                "science-progress-people",
                "upcoming-political-events",
                "volatility-daily",
                "volatility-global",
                "volatility-latest",
                "war-focus-battles",
                "war-focus-monthly-deaths",
                "war-focus-wars"
              ]
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "f.<field>[.<op>]=<value> pairs, e.g. f.country=Chile&f.date.gte=2020-01-01.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "where",
            "in": "query",
            "required": false,
            "description": "Conditions as JSON (instead of f. filters).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "text",
            "in": "query",
            "required": false,
            "description": "Words that must all appear in the row's text fields.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "select",
            "in": "query",
            "required": false,
            "description": "Fields to return, comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Field(s) to sort by, comma-separated; prefix - for descending, e.g. -date.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many to return (default 20, at most 100).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip (at most 10,000).",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "next_cursor from a partial result.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchEncyclopaedia",
        "tags": [
          "Encyclopaedia"
        ],
        "summary": "Find Encyclopaedia entries by name or alias.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Name or part of one.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only this type.",
            "schema": {
              "type": "string",
              "enum": [
                "person",
                "place",
                "party",
                "election",
                "event",
                "topic",
                "idea",
                "conflict",
                "organisation"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many to return (default 10, at most 25).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/entities/{qid}": {
      "get": {
        "operationId": "getEntity",
        "tags": [
          "Encyclopaedia"
        ],
        "summary": "One Encyclopaedia entry by Wikidata id.",
        "parameters": [
          {
            "name": "qid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^Q[0-9]+$"
            }
          },
          {
            "name": "mentions",
            "in": "query",
            "required": false,
            "description": "How many mentions to list (default 15, at most 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/entities": {
      "get": {
        "operationId": "getEntityByTitle",
        "tags": [
          "Encyclopaedia"
        ],
        "summary": "One Encyclopaedia entry by English Wikipedia title.",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "English Wikipedia title, e.g. Korean War.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mentions",
            "in": "query",
            "required": false,
            "description": "How many mentions to list.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "events",
        "tags": [
          "Calendar"
        ],
        "summary": "Political events in a date range (default today to 18 months ahead).",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country name or ISO code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Event types or families, comma-separated (election, referendum, party, leader, inauguration, resignation, coup, conflict, ceasefire, assassination, crisis, protest, treaty, summit, sanctions, vote, court; families ballots, office, coups, war, assassinations, unrest, diplomacy, institutions).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "First date (YYYY-MM-DD; earlier dates give past events back to 1980).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Last date (at most five years after from).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Instead of to: days after from.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1830
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words in the title, country or summary.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "declared or tentative.",
            "schema": {
              "type": "string",
              "enum": [
                "declared",
                "tentative"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many to return (default 25, at most 100).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Events"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/briefings": {
      "get": {
        "operationId": "listBriefings",
        "tags": [
          "Briefings"
        ],
        "summary": "The four briefings, with their API, feed and page addresses.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/briefings/{briefing}": {
      "get": {
        "operationId": "latestBriefing",
        "tags": [
          "Briefings"
        ],
        "summary": "The newest items of a briefing.",
        "parameters": [
          {
            "name": "briefing",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "intelligence",
                "scientific",
                "economics",
                "digital"
              ]
            },
            "description": "Which briefing."
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "description": "Scientific: physics, chemistry, biology, earth, space. Economics: macro, monetary, trade, labour, development, finance, public, energy. Digital: its fields (see the catalogue).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "required": false,
            "description": "Intelligence only: one political position.",
            "schema": {
              "type": "string",
              "enum": [
                "far_left",
                "left",
                "centre",
                "right",
                "far_right"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Scientific, economics, digital: papers or news.",
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "news"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words that must all appear in the title or summary.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "One publisher, by id or name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "description": "Look-back window in hours (default 48 for intelligence, 72 otherwise; at most 336).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 336
            }
          },
          {
            "name": "hard_news",
            "in": "query",
            "required": false,
            "description": "Intelligence: leave out sport, entertainment and lifestyle (default true).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "balance",
            "in": "query",
            "required": false,
            "description": "Intelligence: take items from each position in turn (default true unless a position is given).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Newest first, or major sources first.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "major"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many to return (default 15, at most 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Briefing"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
