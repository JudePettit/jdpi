    "/submodules": {
      "get": {
        "operationId": "listSubmodules",
        "tags": [
          "Catalogue"
        ],
        "summary": "PRP's pages by module.",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "required": false,
            "description": "Only one module.",
            "schema": {
              "type": "string",
              "enum": [
                "rt",
                "rs",
                "mm",
                "ns",
                "ds",
                "kino"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/feeds/{feed}": {
      "get": {
        "operationId": "briefingFeed",
        "tags": [
          "Feeds"
        ],
        "summary": "A briefing as RSS 2.0 (.rss) or JSON Feed 1.1 (.json): the newest 50 items of the last week.",
        "parameters": [
          {
            "name": "feed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(intelligence|scientific|economics|digital)\\.(rss|json)$"
            },
            "description": "e.g. scientific.rss"
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "description": "Scientific: physics, chemistry, biology, earth, space. Economics: macro, monetary, trade, labour, development, finance, public, energy. Digital: its fields (see the catalogue).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "required": false,
            "description": "Intelligence only: one political position.",
            "schema": {
              "type": "string",
              "enum": [
                "far_left",
                "left",
                "centre",
                "right",
                "far_right"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Scientific, economics, digital: papers or news.",
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "news"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words that must all appear in the title or summary.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "One publisher, by id or name.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed",
            "content": {
              "application/rss+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "application/feed+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/calendar.ics": {
      "get": {
        "operationId": "calendarIcs",
        "tags": [
          "Feeds",
          "Calendar"
        ],
        "summary": "Political events as iCalendar (all-day events). Default: six months back to eighteen months ahead.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country name or ISO code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Event types or families, comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "First date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Last date (at most three years after from).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words in the title, country or summary.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "iCalendar",
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    }
  },
