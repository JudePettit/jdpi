nce"]]},"mentions":[{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=1974&c=220","c":"France: 1974 French presidential election","d":"1974-05-19"}],"total":1,"tags":["Type:Election","Century:20th century","Appears in:H&P Retrospective"]},"Q203934":{"q":"Q203934","label":"Panhellenic Socialist Movement","desc":"political party in Greece","type":"party","aliases":[],"wiki":"PASOK","img":null,"summary":"The Panhellenic Socialist Movement, known mostly by its acronym PASOK, was a social-democratic political party in Greece. Following the collapse of the Greek military dictatorship of 1967–1974, PASOK was founded on 3 September 1974 as a socialist party by Andreas Papandreou. The largest left-of-center party in Greece between 1977 and 2012, it was the dominant political party of the country from 1981 to 2004, under party founder Andreas Papandreou and Costas Simitis.","facts":{"founded":"1974-09-03"},"rel":{"Country":[["Q41","Greece"]],"Ideology":[["Q121254","social democracy"],["Q3781399","pro-Europeanism"]],"Member of":[["Q220945","Party of European Socialists"],["Q7248622","Progressive Alliance"]]},"mentions":[{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=1981&c=350","c":"Party of Andreas Papandreou (Greece, 1981–1989)","d":"1981-10-21"},{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=1993&c=350","c":"Party of Andreas Papandreou (Greece, 1993–1995)","d":"1993-10-13"},{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=1996&c=350","c":"Party of Costas Simitis (Greece, 1996–2004)","d":"1996-01-22"}],"total":3,"tags":["Type:Political party","Ideology:Social democracy","Ideology:Pro-Europeanism","Member of:Party of European Socialists","Member of:Progressive Alliance","Century:20th century","Appears in:H&P Retrospective","Role:Party in power","In power in:Greece"]},"Q17091742":{"q":"Q17091742","label":"January 2015 Greek legislative election","desc":"Greek legislative election","type":"election","aliases":["Greek legislative election, January 2015"],"wiki":"January 2015 Greek parliamentary election","img":"Parliament of Greece January 2015.svg","summary":"Parliamentary elections were held in Greece on 25 January 2015 to elect all 300 members of the Hellenic Parliament in accordance with the constitution. The election was held earlier than scheduled due to the failure of the Greek parliament to elect a new president on 29 December 2014.","facts":{"date":"2015-01-25"},"rel":{"Country":[["Q41","Greece"]],"Jurisdiction":[["Q41","Greece"]]},"mentions":[{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=2015&c=350","c":"Greece: January 2015 Greek parliamentary election","d":"2015-01-25"},{"m":"historical-calendar","u":"https://jdpi.pages.dev/q/calendar.html?period=2010s&month=2015-01","c":"Greece: January 2015 Greek parliamentary election","d":"2015-01-25"}],"total":2,"tags":["Type:Election","Century:21st century","Appears in:H&P Retrospective","Appears in:Historical Calendar","Event type:Election"]},"Q3587230":{"q":"Q3587230","label":"2004 Romanian parliamentary election","desc":"","type":"election","aliases":["2004 Romanian legislative election"],"wiki":"2004 Romanian parliamentary election","img":null,"summary":"General elections were held in Romania on 28 November 2004, with a second round of the presidential elections on 12 December between former Prime Minister Adrian Năstase of the then ruling Social Democratic Party (PSD) and then incumbent Bucharest Mayor Traian Băsescu of the opposition Justice and Truth Alliance (DA), more specifically of the Democratic…","facts":{"date":"2004-11-28"},"rel":{"Country":[["Q218","Romania"]],"Jurisdiction":[["Q218","Romania"]]},"mentions":[{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=2004&c=360","c":"Romania: 2004 Romanian parliamentary election","d":"2004-11-28"},{"m":"historical-calendar","u":"https://jdpi.pages.dev/q/calendar.html?period=2000s&month=2004-11","c":"Romania: 2004 Romanian parliamentary election","d":"2004-11-28"}],"total":2,"tags":["Type:Election","Century:21st century","Appears in:H&P Retrospective","Appears in:Historical Calendar","Event type:Election"]},"Q892062":{"q":"Q892062","label":"2002–03 Lithuanian presidential election","desc":"3rd election of the 1990 Republic of Lithuania","type":"election","aliases":["2002-2003 Lithuanian presidential election"],"wiki":"2002–03 Lithuanian presidential election","img":null,"summary":"Presidential elections were held in Lithuania on 22 December 2002, with a second round on 5 January 2003. Incumbent President Valdas Adamkus ran for reelection alongside sixteen other candidates, the largest field of presidential candidates in the country's history.","facts":{"date":"2002-12-22"},"rel":{"Country":[["Q37","Lithuania"]],"Jurisdiction":[["Q37","Lithuania"]]},"mentions":[{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=2003&c=368","c":"Lithuania: 2002–03 Lithuanian presidential election","d":"2003-01-05"},{"m":"historical-calendar","u":"https://jdpi.pages.dev/q/calendar.html?period=2000s&month=2003-01","c":"Lithuania: 2002–03 Lithuanian presidential election","d":"2003-01-05"}],"total":2,"tags":["Type:Election","Century:21st century","Appears in:H&P Retrospective","Appears in:Historical Calendar","Event type:Election"]},"Q4993694":{"q":"Q4993694","label":"Danish Maastricht Treaty referendum","desc":"","type":"election","aliases":[],"wiki":"1993 Danish Maastricht Treaty referendum","img":null,"summary":"A second referendum on the Maastricht Treaty was held in Denmark on 18 May 1993. After rejecting the treaty in a referendum the previous year, this time it was approved by 56.7% of voters with an 86.5% turnout.","facts":{"date":"1993-05-18"},"rel":{"Country":[["Q35","Denmark"]],"Jurisdiction":[["Q35","Denmark"]]},"mentions":[{"m":"retrospective","u":"https://hp-retrospective.pages.dev/#y=1993&c=390","c":"Denmark: 1993 Danish Maastricht Treaty referendum","d":"1993-05-18"},{"m":"historical-calendar",