# Every page: no camera, microphone, payments or USB devices (no page uses them). Location stays allowed for this
# site's own pages, which the SIGINT Dashboard needs; serial ports (its GNSS and mesh radios) are not limited here.
# Allow microphone=(self) here first if a page ever takes voice input.
/*
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)

/design/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# The registry: always revalidated, and readable by other sites and tools (one block: Pages reads each path once).
/registry.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

# The daily data check's result, which the Dashboard's health mark reads: always revalidated.
/status/*
  Cache-Control: no-cache

/lake/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/traders/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Integration Hub (Digital Science): the catalogue, its shards and calendar files, llms.txt and every dataset the
# catalogue lists are readable by browser-based tools on any origin. All public, read-only data.
/integration/*
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

/calendar/data/*
  Access-Control-Allow-Origin: *

/briefing/data/*
  Access-Control-Allow-Origin: *

/science/briefing/data/*
  Access-Control-Allow-Origin: *

/science/progress/data/*
  Access-Control-Allow-Origin: *

/econ/briefing/data/*
  Access-Control-Allow-Origin: *

/digital/briefing/data/*
  Access-Control-Allow-Origin: *

/battlefield/data/*
  Access-Control-Allow-Origin: *

/battlefield/history/data/*
  Access-Control-Allow-Origin: *

/battlefield/focus/data/*
  Access-Control-Allow-Origin: *

/volatility/data/*
  Access-Control-Allow-Origin: *

/national/data/*
  Access-Control-Allow-Origin: *

/kardashev/data/*
  Access-Control-Allow-Origin: *

/kino/data/*
  Access-Control-Allow-Origin: *

/headlines/outlets.json
  Access-Control-Allow-Origin: *

# IoT Connect (Digital Science): the page may reach only this site and the Vitruvian Manager bridge on this computer, on
# its port 8790, and nothing else: no inline script or style, and no framing but by the shell (which frames it). The
# design (PRP-IOT-CONNECT-DESIGN.md §4.2) gives the policy, less its http://[::1]:8790: a CSP source may not be an IPv6
# address (browsers ignore it and report an error), so the page reaches the bridge as localhost or 127.0.0.1 only.
/digital/iot-connect/*
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:8790 http://127.0.0.1:8790; img-src 'self' data:; frame-ancestors 'self'

# The installable app: its manifest and its offline worker are always revalidated, so a new version reaches phones.
/manifest.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
